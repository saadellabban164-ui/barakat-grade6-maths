rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /students/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || admin());
    }
  }
}
