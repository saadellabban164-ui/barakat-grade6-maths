rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function validScore() {
      return request.resource.data.keys().hasOnly(['name', 'class', 'score', 'outOf', 'quizTitle', 'date', 'uid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.class in ['6A', '6B']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.outOf is int
        && request.resource.data.outOf >= 1
        && request.resource.data.outOf <= 20
        && request.resource.data.score <= request.resource.data.outOf
        && request.resource.data.quizTitle is string
        && request.resource.data.quizTitle.size() >= 1
        && request.resource.data.quizTitle.size() <= 80
        && request.resource.data.uid == request.auth.uid;
    }
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn() && validScore();
      allow update, delete: if admin();
    }
    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if admin();
    }
  }
}
